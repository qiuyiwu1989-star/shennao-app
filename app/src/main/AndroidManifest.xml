<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!-- 安卓 14 起，前台服务必须按用途单独申请。少这一条，startForeground 直接抛异常 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <!-- 从录音笔导入也是长活：27 KB/s，一小时录音要传四分半。
         没有它，用户切走看一眼别的，传输就断在半路。 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
    <!-- 安卓 13 起通知要用户点头。拿不到也能录，只是状态栏那条看不见 -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- 蓝牙录音笔导入。安卓 12（API 31）把蓝牙权限拆成了新的两个；
         31 以下扫描仍然要定位权限——**这是最常被忘的一条**，
         漏了它扫描会返回空列表而不是报错，看起来就像「附近没有设备」。
         我们不用蓝牙推断位置，所以声明 neverForLocation。 -->
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN"
        android:usesPermissionFlags="neverForLocation" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION"
        android:maxSdkVersion="30" />
    <uses-feature android:name="android.hardware.bluetooth_le" android:required="false" />

    <!-- 关掉云备份。备份会把应用目录整包上云：里面有还没上传的录音，也有凭证。
         而加密凭证的密钥在系统 keystore 里、不会跟着备份走，恢复出来也解不开——
         那时用户会看到一个「登录了但一直失败」的半死状态，比干脆重登一次更糟。 -->
    <application
        android:name=".ShennaoApp"
        android:label="深脑"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:supportsRtl="true"
        android:theme="@style/Theme.Material3.DayNight.NoActionBar">
        <!--
             singleTask：没有它，每次从通知栏（录音完成/蓝牙导入完成）点回来，
             或者应用已经在后台时再点一次桌面图标，安卓都会在栈顶叠一个
             全新的 MainActivity——旧的那个还活着，两份 App() 各自跑着自己的
             轮询循环。2026-09-02 用户实录抓到证据：nginx 日志里 /api/mobile/sessions
             和 /api/mobile/today 每一拍都成对出现，时间戳几乎相同——正是
             两个并存的实例在同时轮询。 -->
        <activity android:name=".MainActivity" android:exported="true"
            android:launchMode="singleTask"
            android:theme="@style/Theme.App.Starting">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!-- 录音必须挂在前台服务上。放在 Activity 里，用户一切走后台就被冻结，
             而开会时人一定会切走去看别的东西。 -->
        <service
            android:name=".record.RecordingService"
            android:exported="false"
            android:foregroundServiceType="microphone" />
        <!-- 蓝牙导入。类型是 connectedDevice——用 microphone 会在 API 34 上
             被系统按「没有麦克风权限的麦克风服务」直接拒掉。 -->
        <service
            android:name=".ble.BleImportService"
            android:exported="false"
            android:foregroundServiceType="connectedDevice" />
    </application>
</manifest>
